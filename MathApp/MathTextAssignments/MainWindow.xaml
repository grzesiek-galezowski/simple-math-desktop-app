<Window x:Class="MathTextAssignments.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MathTextAssignments"
        mc:Ignorable="d"
        Title="Zadania Matematyczne" Height="700" Width="900"
        Background="#FFE8F4F8" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="120"/>
      <RowDefinition Height="113"/>
      <RowDefinition/>
      <RowDefinition Height="280"/>
    </Grid.RowDefinitions>

    <!-- Problem text -->
    <Border Grid.Row="0" Margin="20,20,20,20" Background="White" CornerRadius="10" BorderBrush="#FF4CAF50" BorderThickness="3">
      <TextBlock x:Name="ProblemTextBlock" 
                       Text="" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="#FF2E7D32"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Padding="20"
                       VerticalAlignment="Center"/>
    </Border>

    <!-- Input fields -->
    <Border Grid.Row="1" Margin="20,20,20,2" Background="White" CornerRadius="10" BorderBrush="#FF2196F3" BorderThickness="2">
      <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">

        <!-- Number 1 -->
        <Border x:Name="Number1Border" 
                        Background="White" 
                        BorderBrush="#FF2196F3" 
                        BorderThickness="2"
                        CornerRadius="5"
                        Width="60" 
                        Height="60"
                        Margin="5">
          <TextBlock x:Name="Number1TextBlock" 
                               Text="" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#FF1976D2"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
        </Border>

        <!-- Operator -->
        <Border x:Name="OperationBorder" 
                        Background="White" 
                        BorderBrush="#FFF57C00" 
                        BorderThickness="2"
                        CornerRadius="5"
                        Width="60" 
                        Height="60"
                        Margin="5">
          <TextBlock x:Name="OperationTextBlock" 
                               Text="" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#FFFF6F00"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
        </Border>

        <!-- Number 2 -->
        <Border x:Name="Number2Border" 
                        Background="White" 
                        BorderBrush="#FF2196F3" 
                        BorderThickness="2"
                        CornerRadius="5"
                        Width="60" 
                        Height="60"
                        Margin="5">
          <TextBlock x:Name="Number2TextBlock" 
                               Text="" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#FF1976D2"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
        </Border>

        <!-- Equals sign -->
        <TextBlock Text="=" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#FF424242"
                           Margin="5"
                           VerticalAlignment="Center"/>

        <!-- Result -->
        <Border x:Name="ResultBorder" 
                        Background="White" 
                        BorderBrush="#FF9C27B0" 
                        BorderThickness="2"
                        CornerRadius="5"
                        Width="60" 
                        Height="60"
                        Margin="5">
          <TextBlock x:Name="ResultTextBlock" 
                               Text="" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Foreground="#FF6A1B9A"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
        </Border>

        <!-- Check/Next button -->
        <Button x:Name="NextCheckButton"
                        Content="Sprawdź"
                        FontSize="18"
                        FontWeight="Bold"
                        Padding="15,10"
                        Background="#FF4CAF50"
                        Foreground="White"
                        Click="NextCheckButton_Click"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Margin="5">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
    </Border>

    <!-- Tips section -->
    <Border Grid.Row="2" Margin="20,10,20,20" Background="#FFF5F5F5" CornerRadius="10">
      <DockPanel LastChildFill="True">
        <!-- Tip button -->
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="10" Orientation="Horizontal">
          <Button x:Name="TipButton"
                  Content="Podpowiedź"
                  FontSize="14"
                  FontWeight="Bold"
                  Padding="15,10"
                  Background="#FF2196F3"
                  Foreground="White"
                  Click="TipButton_Click"
                  Cursor="Hand">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <!-- Numicon bricks display -->
        <local:NumiconBricksControl x:Name="NumiconDisplay" Visibility="Collapsed" DockPanel.Dock="Bottom"/>
      </DockPanel>
    </Border>

    <!-- Keyboard -->
    <Border Grid.Row="3" Margin="20,20,20,20" Background="White" CornerRadius="10" BorderBrush="#FF616161" BorderThickness="2">
      <Grid x:Name="KeyboardGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Numbers 1-9 -->
        <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="0" Grid.Column="3" Content="+" Style="{StaticResource OperatorButtonStyle}" Click="OperatorButton_Click"/>

        <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Content="-" Style="{StaticResource OperatorButtonStyle}" Click="OperatorButton_Click"/>

        <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Content="C" Style="{StaticResource ClearButtonStyle}" Click="ClearButton_Click"/>

        <Button Grid.Row="3" Grid.Column="0" Content="0" Style="{StaticResource NumericButtonStyle}" Click="NumberButton_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Content="←" Style="{StaticResource DeleteButtonStyle}" Click="DeleteButton_Click"/>
        <Grid Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"/>
      </Grid>
    </Border>
  </Grid>
</Window>
